PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google Calendar OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/integrations/google/callback

# Client URL
CLIENT_URL=http://localhost:5173

# =============================================================================
# SMTP Email Service Configuration (Email Verification OTP & Interview Invites)
# =============================================================================
# For Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=youremail@gmail.com
# SMTP_PASS=your_16_digit_app_password
# SMTP_FROM="Interview Management Platform" <youremail@gmail.com>

# For Custom SMTP / Mailtrap / SendGrid / Brevo:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM="Interview Management Platform" <no-reply@yourdomain.com>
