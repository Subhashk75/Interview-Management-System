{
  "name": "interview-management-system",
  "version": "1.0.0",
  "description": "Enterprise Interview Management System",
  "scripts": {
    "backend:compile": "mvn -f backend/pom.xml compile",
    "backend:test": "mvn -f backend/pom.xml test",
    "backend:package": "mvn -f backend/pom.xml package",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  }
}
